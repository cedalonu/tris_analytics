{
  "name": "tris-analytics",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:vite": "vite",
    "build": "vite build && esbuild server.ts --bundle --platform=node --target=node20 --outfile=server.js --format=esm --packages=external",
    "start": "node server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:research": "tsx --test src/research/*.test.ts",
    "research:pools": "tsx scripts/run-pool-matrix.ts",
    "research:sync": "tsx scripts/run-tris-sync.ts",
    "research:prospective": "tsx scripts/run-tris-prospective.ts",
    "research:validate": "tsx scripts/run-tris-validation.ts",
    "research:collective": "tsx scripts/run-tris-collective.ts",
    "research:regime": "tsx scripts/run-tris-regime.ts",
    "research:persistence": "tsx scripts/run-tris-persistence.ts",
    "research:memory": "tsx scripts/run-tris-memory.ts",
    "research:context-memory": "tsx scripts/run-tris-context-memory.ts",
    "research:interactions": "tsx scripts/run-tris-interactions.ts"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "ml-random-forest": "^2.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "~5.8.2",
    "vite": "^8.3.8"
  }
}
